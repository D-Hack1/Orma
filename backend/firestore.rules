rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function access(f) { return get(/databases/$(database)/documents/families/$(f)/access/$(request.auth.uid)).data; }
    function member(f, m) { return get(/databases/$(database)/documents/families/$(f)/members/$(m)).data; }
    function sharing(f, m) { return get(/databases/$(database)/documents/families/$(f)/members/$(m)/settings/sharing).data; }
    function active(f, m) { return signedIn() && access(f).active == true && m in access(f).memberIds; }
    function owner(f, m) { return active(f, m) && member(f, m).get('ownerUid', '') == request.auth.uid; }
    function assigned(f, m) {
      return active(f, m) && (owner(f, m)
        || access(f).roles.hasAny(['leadSupporter', 'supporter'])
        || ('nurse' in access(f).roles && request.auth.uid in member(f, m).nurseIds));
    }
    function shared(f, m, field) {
      let settings = sharing(f, m);
      let overrides = settings.get('perSupporter', {}).get(request.auth.uid, {});
      return overrides.get(field, settings.get(field, false)) == true;
    }
    function current(f, m) { return resource.data.get('sharingVersion', -1) == sharing(f, m).get('version', 0); }
    match /families/{f} {
      allow read: if signedIn() && access(f).active == true;
      match /access/{uid} { allow read: if signedIn() && request.auth.uid == uid; }
      match /members/{m} {
        allow read: if owner(f, m);
        match /{collection}/{id} { allow read: if owner(f, m); }
      }
      match /views/{viewer}/members/{m} {
        allow read: if signedIn() && request.auth.uid == viewer && assigned(f, m)
          && resource.data.keys().hasOnly(['name', 'mode']);
        match /doses/{id} {
          allow read: if signedIn() && request.auth.uid == viewer && assigned(f, m)
            && (resource.data.keys().hasOnly(['date', 'slot', 'status'])
              || (shared(f, m, 'counts') && resource.data.keys().hasOnly(['date', 'slot', 'status', 'countTaken', 'countExpected', 'medicinesTaken'])));
        }
        match /alerts/{id} {
          allow read: if signedIn() && request.auth.uid == viewer && assigned(f, m)
            && resource.data.keys().hasOnly(['type', 'rule', 'date', 'slot', 'at'])
            && (resource.data.get('type', '') != 'stock' || shared(f, m, 'counts'))
            && (resource.data.get('type', '') != 'risk' || shared(f, m, 'risk'));
        }
        match /{collection}/{id} {
          allow read: if signedIn() && request.auth.uid == viewer && assigned(f, m)
            && ((collection == 'schedule' && shared(f, m, 'counts'))
              || (collection == 'messages' && current(f, m)
                && (shared(f, m, 'messages')
                  || (resource.data.get('directDelivery', false) == true
                    && request.auth.uid in resource.data.get('to', [])
                    && resource.data.get('from', '') == member(f, m).ownerUid)))
              || (collection == 'risk' && shared(f, m, 'risk'))
              || (collection == 'notes' && shared(f, m, 'nurseNotes'))
              || (collection in ['answers', 'digests', 'reports'] && current(f, m)));
        }
      }
    }
    match /flModels/{version} { allow read: if signedIn(); }
    // Canonical mutations, bindings, calls, alerts, FL updates and projections are server-only.
    match /{document=**} { allow write: if false; }
  }
}
