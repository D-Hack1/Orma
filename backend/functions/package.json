{
  "name": "orma-functions",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run --exclude 'test/rules*'",
    "test:rules": "firebase emulators:exec --config ../../firebase.json --project demo-orma --only auth,firestore,storage 'vitest run test/rules*.test.ts'",
    "emulators": "npm run build && firebase emulators:start --config ../../firebase.json --project demo-orma",
    "seed": "tsx ../scripts/seed.ts",
    "reset-demo": "tsx ../scripts/reset-demo.ts",
    "demo-token": "tsx ../scripts/demo-token.ts",
    "generate-audio": "tsx ../scripts/generate-audio.ts --admin-generate"
  },
  "dependencies": {
    "@google-cloud/text-to-speech": "^7.2.0",
    "@google/genai": "^1.49.0",
    "firebase-admin": "^13.6.0",
    "firebase-functions": "^7.0.0",
    "openai": "^6.0.0",
    "pdfkit": "^0.20.2",
    "twilio": "^5.10.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/pdfkit": "^0.17.7",
    "firebase": "^12.0.0",
    "firebase-tools": "^15.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^5.1.0"
  }
}
