# Nonsecret settings only. Copy to an ignored .env.<real-project-id> for deployment.
# Runtime project/bucket config comes from Firebase. Never put API secrets here.
VERTEX_LOCATION=asia-south1
GEMINI_UNDERSTAND_MODEL=gemini-2.5-flash
GEMINI_VISION_MODEL=gemini-2.5-pro
TWILIO_ACCOUNT_SID=AC_REPLACE_WITH_ACCOUNT_SID
TWILIO_FROM_NUMBER=+15005550006
TWILIO_ALLOWED_NUMBERS=+919876543210
VOICE_PUBLIC_URL=https://asia-south1-YOUR_PROJECT.cloudfunctions.net/voice
SMS_PUBLIC_URL=https://asia-south1-YOUR_PROJECT.cloudfunctions.net/sms
# Secret Manager: OPENAI_API_KEY, TWILIO_AUTH_TOKEN, FL_PSEUDONYM_KEY (>=32 bytes).
